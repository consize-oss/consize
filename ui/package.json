{
  "name": "consize-oss-ui",
  "version": "0.3.0-alpha",
  "private": true,
  "scripts": {
    "api:generate": "openapi-typescript ../openapi/openapi.yaml -o lib/generated/api.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "NODE_PATH=./node_modules node ../tools/ci/node_modules/eslint/bin/eslint.js --config ../tools/ci/eslint.config.mjs . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import ./tests/typescript-loader.mjs --test src/lib/*.test.ts ../scripts/ci/doc-copy.test.mjs",
    "test:e2e": "node ../tools/ci/node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.71.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "msw": "^2.4.9",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  }
}
